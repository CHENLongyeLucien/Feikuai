NODE_ENV=development
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
APPROVER_ORIGIN=http://localhost:5174
DATABASE_PATH=./var/secure-finance.sqlite
ARTIFACT_ROOT=./var/artifacts
DEPLOYMENT_MANIFEST_PATH=./deployments/local.json
TRUSTED_REGISTRY_PATH=./fixtures/trusted-registry.local.json
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
AGENT_MODE=fixture
OPENAI_API_KEY=
OPENAI_MODEL=
AGENT_MAX_MODEL_REQUESTS_PER_STAGE=4
AGENT_MAX_TOOL_CALLS_PER_STAGE=3
AGENT_STAGE_TIMEOUT_MS=60000
SESSION_SECRET=
RELAYER_PRIVATE_KEY=
ENABLE_DEMO_ROUTES=true
ENABLE_MAINNET=false

# Optional Fuji configuration: public addresses only; five distinct roles.
# Deployer key stays in encrypted Foundry keystore sf-fuji-deployer.
# The human approver key is never configured on the server.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_DEPLOYER_ADDRESS=
FUJI_APPROVER_ADDRESS=
FUJI_RELAYER_ADDRESS=
FUJI_SUPPLIER_1_ADDRESS=
FUJI_SUPPLIER_2_ADDRESS=
# Change deployment/registry/chain settings together before selecting Fuji.
SEED_ON_START=false
