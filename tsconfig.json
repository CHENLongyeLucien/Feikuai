{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@secure-finance/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@secure-finance/chain": [
        "./packages/chain/src/index.ts"
      ],
      "@secure-finance/evidence": [
        "./packages/evidence/src/index.ts"
      ]
    }
  },
  "include": [
    "apps",
    "packages",
    "scripts",
    "tests",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
