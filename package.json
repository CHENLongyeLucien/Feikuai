{
  "name": "secure-finance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.14.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,approver \"tsx watch apps/api/src/index.ts\" \"vite --config apps/web/vite.config.ts\" \"vite --config apps/approver/vite.config.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsx scripts/build.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --config tests/e2e/experience.config.ts",
    "test:acceptance": "tsx scripts/acceptance.ts",
    "test:workflow": "node --import tsx scripts/workflow-validation/run.ts",
    "fixtures:workflow": "node --import tsx scripts/workflow-validation/generate.ts",
    "test:workflow:v2": "node --import tsx scripts/workflow-validation/run.ts --suite v2",
    "test:workflow:v2:live": "node --import tsx scripts/workflow-validation/run.ts --suite v2 --live",
    "fixtures:workflow:v2": "node --import tsx scripts/workflow-validation/generate.ts --suite v2",
    "fixtures:manual": "tsx scripts/manual-tests/generate.ts",
    "test:manual-pack": "tsx scripts/manual-tests/validate.ts",
    "integration:token": "tsx scripts/integration-token.ts",
    "integration:demo": "tsx scripts/integration/erp-demo.ts",
    "deploy:vercel": "tsx scripts/deploy-vercel.ts",
    "fixtures:demo": "tsx scripts/demo-pack/generate.ts",
    "test:demo-pack": "tsx scripts/manual-tests/validate.ts --pack demo",
    "history:reset": "tsx scripts/reset-history.ts",
    "doctor": "tsx scripts/doctor.ts",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "evidence:verify": "tsx scripts/evidence-verify.ts",
    "demo:prepare": "tsx scripts/doctor.ts --prepare",
    "demo:run": "tsx scripts/demo.ts",
    "chain:local": "node scripts/foundry.mjs anvil --host 127.0.0.1 --chain-id 31337 --hardfork cancun --block-time 1 --state var/anvil-state.json --preserve-historical-states --state-interval 30",
    "contracts:build": "node scripts/foundry.mjs forge build --root contracts",
    "test:contracts": "node scripts/foundry.mjs forge test --root contracts -vv",
    "contracts:export-abi": "tsx scripts/export-abi.ts",
    "contracts:deploy:local": "tsx scripts/deploy-local.ts",
    "contracts:deploy:fuji": "tsx scripts/deploy-fuji.ts",
    "fuji:preflight": "tsx scripts/chain-preflight.ts --fuji",
    "test:fuji": "tsx scripts/chain-fuji-test.ts",
    "relayer:recover-nonce": "tsx scripts/relayer-recover.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "demo:configure:local": "tsx scripts/configure-local.ts",
    "contracts:golden": "tsx scripts/chain-local-test.ts --golden-only",
    "chain:snapshot": "tsx scripts/chain-snapshot.ts",
    "demo:start": "tsx scripts/demo-start.ts",
    "benchmark:fetch": "tsx scripts/benchmark/fetch-corpus.ts && python3 -I scripts/benchmark/parse_nazario.py var/benchmark-data/nazario var/benchmark-data/nazario.jsonl && python3 -I scripts/benchmark/sample_enron.py var/benchmark-data/enron var/benchmark-data/enron-sample.jsonl 5000",
    "benchmark:detection": "tsx scripts/benchmark/detection.ts",
    "benchmark:chain": "tsx scripts/benchmark/chain-escape.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fontsource/inter": "5.3.0",
    "@noble/hashes": "2.4.0",
    "@openzeppelin/contracts": "5.7.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@vitejs/plugin-react": "6.1.2",
    "better-sqlite3": "13.0.3",
    "canonicalize": "5.1.0",
    "dotenv": "18.0.7",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "fflate": "0.8.3",
    "lucide-react": "1.55.0",
    "openai": "7.32.0",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "viem": "2.57.4",
    "vite": "8.3.4",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
